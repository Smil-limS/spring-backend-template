root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Google Java Format 기준 (2칸 들여쓰기, 100자)
[*.java]
indent_style = space
indent_size = 2
max_line_length = 100

[*.{yml,yaml,json,xml,cjs}]
indent_style = space
indent_size = 2

[*.gradle]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
