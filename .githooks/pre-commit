#!/bin/sh
# 스테이징된 Java 파일이 있으면 spotlessApply 로 자동 포맷하고 다시 스테이징한다.
# (검사만 하고 실패시키는 대신 고쳐 주므로 커밋 흐름이 끊기지 않는다)

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '\.java$')
[ -z "$STAGED" ] && exit 0

echo "[pre-commit] spotlessApply 실행 중..."
if ! ./gradlew spotlessApply -q; then
  echo ""
  echo "❌ [pre-commit] 포맷 적용에 실패했습니다. ./gradlew spotlessApply 로 오류를 확인하세요."
  echo ""
  exit 1
fi

echo "$STAGED" | while IFS= read -r f; do
  [ -f "$f" ] && git add "$f"
done
exit 0
